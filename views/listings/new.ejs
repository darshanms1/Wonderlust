
   <% layout("/layouts/boilerplate")%>
  

<div class="row">
    <div class="col-8 offset-2">
        <h4>Create New List</h4>
    <form action="/listings" method="post" class="needs-validation" novalidate enctype="multipart/form-data">

        <div class="md-3">
        <label for="title" class="form-label">name</label>
        <input type="text" name="listing[title]" placeholder="name" class="form-control" id="title" required>
        <div class="valid-feedback">
            nice title
        </div>
        </div>
        <br>

       <div class="md-3">
        <label for="description" class="form-label">description</label>
        <textarea name="listing[description]" placeholder="description" class="form-control" id="description" required></textarea>
        </div>
        <br>

        <div class="md-3">
            <label for="image" class="form-label">image Link</label>
              <input type="file" name="listing[image]"  class="form-control">
        </div>
        <br>

        <div class="row">
            <div class="md-3 col-md-4">
            <label for="price" class="form-label">price</label>
                 <input /**type="number"**/ name="listing[price]" placeholder="price" class="form-control" required>
                 <div class="invalid-feedback">
                  enter valid price
                 </div>
            </div>
           <br>

           <div class="md-3 col-md-8">
           <label for="country" class="form-label"> country</label>                  
           <input type="text" name="listing[country]" placeholder="country" class="form-control" required>
            </div>
      </div>
      
        <br>
       
         <div class="md-3">
        <label for="location" class="form-label">location</label>
             <input type="text" name="listing[location]" placeholder="location" class="form-control" required>
       </div>
     
        
        

        <br>
        <button class="btn btn-dark  add-btn-color">add</button>
        <br><br>
    </form>
    </div>
    </div>
